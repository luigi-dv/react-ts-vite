{
  "name": "react-ts-vite",
  "version": "0.2.0",
  "description": "React + TypeScript + Vite + Tailwind CSS starter with selectable architectures, design templates, AI-agent skills (.agent) and Claude-powered deployment insights.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "Luigi Davila",
  "homepage": "https://github.com/Luigi-DV/react-ts-vite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luigi-DV/react-ts-vite.git"
  },
  "bugs": {
    "url": "https://github.com/Luigi-DV/react-ts-vite/issues"
  },
  "keywords": [
    "react",
    "typescript",
    "vite",
    "tailwindcss",
    "vitest",
    "template",
    "starter",
    "boilerplate",
    "scaffold",
    "clean-architecture",
    "feature-sliced-design",
    "atomic-design",
    "headlessui",
    "heroicons",
    "agent-skills",
    "claude"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "react-ts-vite": "bin/rtv.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "templates",
    ".agent",
    ".claude",
    ".github",
    "docs",
    "docker",
    "public",
    "src",
    "__tests__",
    "index.html",
    "vite.config.ts",
    "vitest.setup.ts",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.node.json",
    "tailwind.config.cjs",
    "postcss.config.cjs",
    "eslint.config.js",
    ".prettierrc.json",
    ".prettierignore",
    ".editorconfig",
    ".nvmrc",
    "rtv.config.json",
    "CLAUDE.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run arch:check && npm run agent:check && npm run test:run",
    "setup": "node bin/rtv.mjs setup",
    "arch": "node bin/rtv.mjs arch",
    "arch:check": "node bin/rtv.mjs arch check",
    "templates": "node bin/rtv.mjs templates",
    "agent": "node bin/rtv.mjs agent",
    "agent:sync": "node bin/rtv.mjs agent sync",
    "agent:check": "node bin/rtv.mjs agent check",
    "deploy:insights": "node bin/rtv.mjs insights",
    "postinstall": "node bin/rtv.mjs agent sync --quiet --if-project"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
