{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npm run test:*)",
      "Bash(npm run coverage:*)",
      "Bash(npm run build:*)",
      "Bash(npm run arch:*)",
      "Bash(npm run templates:*)",
      "Bash(npm run agent:*)",
      "Bash(npm run deploy:insights:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(node bin/rtv.mjs:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/post-edit.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
