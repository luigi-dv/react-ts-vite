{
  "$schema": "./scripts/schema/rtv.config.schema.json",
  "version": 1,
  "architecture": "classic",
  "templates": [],
  "design": {
    "system": "tailwind",
    "ui": ["@headlessui/react", "@heroicons/react"]
  },
  "claude": {
    "deploymentInsights": false,
    "model": "claude-opus-5-5",
    "effort": "medium"
  },
  "rules": {
    "allow": []
  },
  "aliases": {
    "@": "./src",
    "@assets": "./src/assets",
    "@components": "./src/components",
    "@const": "./src/const",
    "@hooks": "./src/hooks",
    "@pages": "./src/pages",
    "@services": "./src/services",
    "@types": "./src/types",
    "@utils": "./src/utils"
  }
}
