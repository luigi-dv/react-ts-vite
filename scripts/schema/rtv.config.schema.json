{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luigi-dv/react-ts-vite/blob/master/scripts/schema/rtv.config.schema.json",
  "title": "react-ts-vite project configuration",
  "description": "Declares the project's shape: architecture, applied design templates, Claude settings and the path-alias map read by vite.config.ts.",
  "type": "object",
  "required": ["version", "architecture", "aliases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "architecture": {
      "description": "Active folder architecture. Switch with `npm run arch -- apply <id>`.",
      "type": "string",
      "enum": ["classic", "feature", "fsd", "clean", "atomic"]
    },
    "templates": {
      "description": "Applied design templates, in route order (the first one is the home route unless one claims '/').",
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "uniqueItems": true
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": { "type": "string", "enum": ["tailwind"] },
        "ui": { "type": "array", "items": { "type": "string" } }
      }
    },
    "claude": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deploymentInsights": {
          "description": "Run Claude on deployment (workflow + `npm run deploy:insights`).",
          "type": "boolean"
        },
        "model": {
          "description": "Claude model id, e.g. claude-opus-5-5 or claude-sonnet-5-5.",
          "type": "string",
          "pattern": "^claude-"
        },
        "effort": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"] }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "description": "Extra allowed layer dependencies, as \"from>to\" (e.g. \"presentation>infrastructure\").",
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "pattern": "^[a-z-]+>[a-z-]+$" },
              { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 }
            ]
          }
        }
      }
    },
    "aliases": {
      "description": "Path aliases (name → project-relative folder). Regenerated by `npm run arch`.",
      "type": "object",
      "propertyNames": { "pattern": "^@[a-zA-Z0-9-]*$" },
      "additionalProperties": { "type": "string", "pattern": "^\\./" }
    }
  }
}
